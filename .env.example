# 复制为 .env 后按需修改。.env 已被 .gitignore 忽略，切勿提交真实密钥。

# --- 数据库 ---
POSTGRES_USER=olo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=olo
# 本地（非 docker）运行 API / pytest 时使用
DATABASE_URL=postgresql://olo:change-me@127.0.0.1:5432/olo

# --- API 鉴权（客户端以 Authorization: Bearer <token> 访问） ---
OLO_API_TOKEN=change-me-long-random-token

# --- 大模型（任何 OpenAI 兼容接口：OpenAI / DeepSeek / 通义千问 DashScope / 本地 vLLM、Ollama 等） ---
# LLM_PROVIDER=mock 时完全离线，不需要密钥
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 例：DeepSeek  OPENAI_BASE_URL=https://api.deepseek.com/v1  OPENAI_MODEL=deepseek-chat
# 例：通义千问   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
OPENAI_MODEL=gpt-4o-mini

# --- 长期记忆（VoiceMem，全部走 API，不需要 torch / 本地模型） ---
# auto = 有 OPENAI_API_KEY 时启用；off = 只用内置 FakeMemory；voicemem = 强制启用（缺 key 会告警并回落）
OLO_MEMORY=auto
# 记忆的抽取/分类用上面的 OPENAI_MODEL；向量嵌入可单独指向另一家（DeepSeek 没有 embeddings 接口）
# 留空则复用 OPENAI_API_KEY / OPENAI_BASE_URL
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# 必须等于模型实际输出维度：text-embedding-3-small=1536；DashScope text-embedding-v3=1024
EMBEDDING_DIMENSIONS=1536
# 记忆库目录（docker 内固定为 /app/data/voicemem，在 appdata 卷上）
OLO_VOICEMEM_DIR=
# 记忆内部 LLM（抽取事实 + 写入时打标签）。留空 = 用 OPENAI_MODEL。实测 qwen-flash 并不比 qwen-plus 快（瓶颈是 45KB 的抽取提示词）
OLO_MEMORY_MODEL=
# 检索时的查询分类：embedding（默认，0 次 LLM，~0.3s）| llm（VoiceMem 原版，多 1 次 LLM ~1-2s，会额外抽实体）
OLO_MEMORY_CLASSIFIER=embedding
# 每轮检索记忆的等待上限（秒）。API 模式下一次检索约 0.5–2s；超时这一轮不注入也不写入记忆
OLO_SEARCH_WAIT_S=3
# 语音消息转写模型（/audio/transcriptions）
OLO_ASR_MODEL=whisper-1

# --- 可选功能 ---
OLO_TTS=0                 # 1 = 语音回复（调用 /audio/speech，失败则回落文字）
OLO_CHECKINS=1            # 主动关心的定时任务
OLO_TLS=0                 # 1 = 要求 TLS 证书（直连手机时使用），见 OLO_TLS_CERT / OLO_TLS_KEY
OLO_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
OLO_WEB_EMBED_TOKEN=0     # 1 = 网页 /app 自动带上 API token（仅限本机演示，docker compose 默认开启）
API_PORT=8000
