# 公开测试/上架用的服务器配置样例。复制成 .env 后填空；不要提交真实值。
OLO_PUBLIC=1
OLO_DEBUG=0
OLO_LEGACY_TOKEN=0
OLO_WEB_EMBED_TOKEN=0
OLO_DEV_SUBSCRIPTIONS=0

DATABASE_URL=postgresql://olo@127.0.0.1:5432/olo

# 登录验证码邮件（免费：Gmail 两步验证 + 应用专用密码）
OLO_EMAIL_SENDER=smtp
OLO_SMTP_HOST=smtp.gmail.com
OLO_SMTP_PORT=587
OLO_SMTP_USER=leedusty91@gmail.com
OLO_SMTP_PASSWORD=
OLO_SMTP_FROM=olo <leedusty91@gmail.com>

# 模型/记忆的密钥照旧只放环境变量
LLM_PROVIDER=
