{
  "expo": {
    "name": "olo",
    "slug": "olo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.github.leedusty91.olo",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "olo 只连接你自己部署的服务器（局域网内）。",
        "NSMicrophoneUsageDescription": "按住说话时，用麦克风录一条语音备忘。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "io.github.leedusty91.olo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/app-mobile"
    }
  }
}
