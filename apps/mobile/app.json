{
  "expo": {
    "name": "olo",
    "slug": "olo",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.olo.companion",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "olo 只连接你自己部署的服务器（局域网内）。",
        "NSMicrophoneUsageDescription": "按住说话时，用麦克风录一条语音备忘。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.olo.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD6AA"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "olo 想把分享卡片存进你的相册。",
          "savePhotosPermission": "olo 想把分享卡片存进你的相册。",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBEFE6"
    },
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
